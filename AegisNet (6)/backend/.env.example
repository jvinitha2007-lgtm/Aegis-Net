PORT=4000
SESSION_SECRET=change-this-to-a-long-random-secret-before-deployment
FRONTEND_ORIGIN=http://127.0.0.1:5175

# Optional external incident alerts. Configure either channel or both.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# Optional signed webhook: AegisNet sends incident.created JSON with
# X-AegisNet-Signature: sha256=<HMAC-SHA256 hex digest>
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=